# Lindsay FastAPI Configuration
# Copy to .env and fill with your values

# ============================================================================
# Application
# ============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================================================
# Database (CouchDB)
# ============================================================================
COUCHDB_URL=http://localhost:5984
COUCHDB_DB=lindsay-data

# ============================================================================
# Security
# ============================================================================
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# MQTT Configuration
# ============================================================================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=lindsay/#
MQTT_QOS=1
MQTT_CLIENT_ID=lindsay-api
MQTT_PUBLISHER_CLIENT_ID=lindsay-api-publisher

# ============================================================================
# Workers & Queue
# ============================================================================
WORKER_COUNT=8
QUEUE_MAXSIZE=5000
QUEUE_PUT_TIMEOUT=0.01
ON_QUEUE_FULL=block
COUCHDB_CHANGES_TIMEOUT_MS=30000
COUCHDB_CHANGES_HTTP_TIMEOUT=65

# ============================================================================
# Notifications / Z-API / WebSocket
# ============================================================================
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
ZAPI_BASE_URL=https://api.z-api.io
NOTIFICATION_MODE=whatsapp_zapi
RATE_LIMIT_DELAY=0.5
VOICE_ZAPI_MAX_ATTEMPTS=5
API_PUBLIC_BASE_URL=https://api.lindsay.vpn.ind.br
ZAPI_WEBHOOK_URL=
ZAPI_AUTO_CONFIGURE_WEBHOOK=false
WS_HOST=127.0.0.1
WS_PORT=8765
WS_PATH=/ws
WS_PING_INTERVAL=30

# ============================================================================
# Timezone
# ============================================================================
TIMEZONE=America/Sao_Paulo
