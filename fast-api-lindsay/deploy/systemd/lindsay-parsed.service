[Unit]
Description=Lindsay legacy parsed worker
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/lindsay-fastapi/fast-api-lindsay
EnvironmentFile=/home/ubuntu/lindsay-fastapi/fast-api-lindsay/.env
Environment="PATH=/home/ubuntu/.cargo/bin:/home/ubuntu/.local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/.local/bin/uv run python -u -m app.workers.mqtt_listener
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
